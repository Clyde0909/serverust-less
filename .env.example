# Serverust-Less Environment Configuration
# Copy this file to .env and modify as needed

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
SERVER_LOG_LEVEL=info

# Database
DATABASE_PATH=./data/serverust.db
DATABASE_MAX_CONNECTIONS=10

# Worker
WORKER_POOL_SIZE=4
WORKER_DEFAULT_TIMEOUT_SECONDS=30
WORKER_DEFAULT_MEMORY_LIMIT_MB=128
